# Copy to .env.production and fill in. Never commit it. Used by docker-compose.prod.yml.
DOMAIN=technews.example.com            # the public address; DNS must point at this server

# Generate each password with:  openssl rand -base64 24 | tr -d '/+='
MONGO_USER=technews
MONGO_PASSWORD=
REDIS_PASSWORD=
TEMPORAL_DB_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_CALLS_PER_SECOND=1
LLM_DAILY_CAP=800

# Sign-in (docs/05-accounts.md). Add DOMAIN to Firebase > Authentication > Authorized domains.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# Required: only these Firebase user ids may press Refresh (comma-separated); it spends Gemini quota.
# Find your id in Firebase > Authentication > Users (the "User UID" column). Compose refuses to start without it.
REFRESH_ADMIN_UIDS=YCBoWa2sXtM0G3JXjYxWpvJWI1t2
# Optional: page describing your crawler, shown in the User-Agent of outgoing requests. Default: https://DOMAIN
BOT_INFO_URL=
