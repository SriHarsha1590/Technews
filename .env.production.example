# Copy to .env.production. Keep it private (chmod 600 .env.production).
DOMAIN=technews.example.com

# Generate each password with: openssl rand -hex 32
# Mongo app user is created only when mongo-data is first initialized.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=technews
MONGO_APP_PASSWORD=
MONGO_BACKUP_USER=technews_backup
MONGO_BACKUP_PASSWORD=
REDIS_PASSWORD=

# A managed Temporal namespace is required for production.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_CALLS_PER_SECOND=1
WORKER_LLM_DAILY_CAP=800
PUBLIC_LLM_DAILY_CAP=100

FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
REFRESH_ADMIN_UIDS=
BOT_INFO_URL=

# S3 destination used by deploy/backup.sh; grant this server write access via instance role
# or a restricted AWS profile. Use bucket lifecycle rules for retention and versioning.
BACKUP_S3_URI=s3://your-private-backup-bucket/technews

# Optional external JSON log sink via deploy/docker-compose.logging.yml.
FLUENTD_ADDRESS=
