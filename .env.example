# Copy to .env and fill in GEMINI_API_KEY. Everything else has working local defaults.

# --- Host ports for docker compose. Change a port here AND in the matching URL below if it's taken. ---
MONGO_PORT=27017
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Connections used by the apps ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=technews
REDIS_URL=redis://localhost:6379
# TEMPORAL_ADDRESS=localhost:7233

# --- AI (worker) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_CALLS_PER_SECOND=0.1
LLM_DAILY_CAP=800

# --- API ---
API_PORT=4000
# Comma-separated list of web origins allowed to call the API from a browser
WEB_ORIGINS=http://localhost:5173

# --- Sign-in (Firebase Auth). Leave empty to run without accounts. See docs/05-accounts.md ---
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Notifications (Web Push). generate with `npx web-push generate-vapid-keys`; keep the private key secret ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Production (see docs/06-deploy.md and .env.production.example) ---
# Browser-visible API address, baked in when the web app is built. Default: http://localhost:4000/api/v1
# VITE_API_URL=https://technews.example.com/api/v1
# Proxies in front of the API (Nginx, Cloudflare, a load balancer). Needed so rate limits see each visitor.
# TRUST_PROXY=1
# Only these Firebase user ids may press Refresh (comma-separated). Empty: any signed-in reader.
# REFRESH_ADMIN_UIDS=
# Page describing your crawler; shown in the User-Agent of outgoing requests.
# BOT_INFO_URL=https://technews.example.com
